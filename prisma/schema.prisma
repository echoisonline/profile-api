generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id           String  @id
  name         String
  description  String
  githubUrl    String
  skills       Skill[]
  experience   Experience[]
  projects     Projects[]
}
model Skill {
  id String @id
  name String
  profileId String
  profile Profile @relation(fields: [profileId], references: [id])
}

model Experience {
  id String @id
  company String
  position String
  startedAt DateTime @db.Date
  endedAt DateTime? @db.Date
  achievements String
  profileId String
  profile Profile @relation(fields: [profileId], references: [id])
}

model Projects {
  id String @id
  name String
  url String
  description String
  profileId String
  profile Profile @relation(fields: [profileId], references: [id])
}